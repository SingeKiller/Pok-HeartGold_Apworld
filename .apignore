# .apignore
#
# Lists what goes into the final .apworld (everything else is excluded).
# Read by build.py / Makefile.
#
# Format: "**" excludes everything by default; a line starting with "!/"
# re-includes a repository-root-relative path. A trailing "/" means the
# whole directory is included recursively; otherwise it's a single file.

**
!/__init__.py
!/client.py
!/items.py
!/locations.py
!/options.py
!/output_patch.py
!/patch_gen.py
!/regions.py
!/rules.py
!/species.py
!/universal_tracker.py
!/save_layout.py
!/location_flags.py
!/LICENSE
!/data/
!/patches/exp_share.s
!/patches/ground_item_hook.s
!/patches/shop_purchase_hook.s
!/rom/
!/apnds/
!/apnds_version.txt
!/docs/setup_en.md
!/docs/en_Pokemon HeartGold.md
